# ============================================================
# AiKnow — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/aiknow
DATABASE_USERNAME=aiknow
DATABASE_PASSWORD=changeme

# --- JWT Authentication ---
# Must be at least 32 characters (256 bits) for HS256
JWT_SECRET=your-256-bit-secret-key-here-change-this-in-production
# Access token expiration: 15 minutes (in milliseconds)
JWT_EXPIRATION_MS=900000
# Refresh token expiration: 7 days (in milliseconds)
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Retry/backoff for transient Gemini API failures
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_MS=500

# --- File Storage ---
# Local filesystem path for uploaded documents
FILE_STORAGE_PATH=./uploads

# --- RAG Retrieval ---
# Number of top chunks retrieved per query
RAG_TOP_K=5
# Minimum cosine similarity threshold for a chunk to be considered relevant
RAG_MIN_SIMILARITY=0.65
# Max number of prior conversation messages included as chat history context
RAG_MAX_HISTORY_MESSAGES=10
