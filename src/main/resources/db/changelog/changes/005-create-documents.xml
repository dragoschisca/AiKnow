<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-documents" author="aiknow">
        <createTable tableName="documents">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_documents_org"
                             references="organizations(id)"/>
            </column>
            <column name="workspace_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_documents_workspace"
                             references="workspaces(id)"/>
            </column>
            <column name="name" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="original_filename" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="file_size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_path" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="UPLOADED">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="version" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_documents_uploaded_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="documents" indexName="idx_documents_org_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_workspace_id">
            <column name="workspace_id"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_org_ws">
            <column name="organization_id"/>
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-document-chunks" author="aiknow">
        <createTable tableName="document_chunks">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_chunks_document"
                             references="documents(id)"
                             deleteCascade="true"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_chunks_org"
                             references="organizations(id)"/>
            </column>
            <column name="workspace_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_chunks_workspace"
                             references="workspaces(id)"/>
            </column>
            <column name="chunk_index" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="page_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="token_count" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- pgvector embedding column added via raw SQL since Liquibase doesn't natively support vector type -->
        <sql>ALTER TABLE document_chunks ADD COLUMN embedding vector(768);</sql>

        <createIndex tableName="document_chunks" indexName="idx_chunks_document_id">
            <column name="document_id"/>
        </createIndex>
        <createIndex tableName="document_chunks" indexName="idx_chunks_org_ws">
            <column name="organization_id"/>
            <column name="workspace_id"/>
        </createIndex>

        <!-- IVFFlat index for approximate nearest neighbor search -->
        <sql>CREATE INDEX idx_chunks_embedding ON document_chunks USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);</sql>
    </changeSet>

</databaseChangeLog>
