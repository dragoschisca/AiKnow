<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-audit-logs" author="aiknow">
        <createTable tableName="audit_logs">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints foreignKeyName="fk_audit_org"
                             references="organizations(id)"/>
            </column>
            <column name="workspace_id" type="UUID">
                <constraints foreignKeyName="fk_audit_workspace"
                             references="workspaces(id)"/>
            </column>
            <column name="actor_user_id" type="UUID">
                <constraints foreignKeyName="fk_audit_actor"
                             references="users(id)"/>
            </column>
            <column name="event_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_type" type="VARCHAR(50)"/>
            <column name="resource_id" type="UUID"/>
            <column name="details" type="JSONB"/>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="audit_logs" indexName="idx_audit_org_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_event_type">
            <column name="event_type"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-create-organization-usage" author="aiknow">
        <createTable tableName="organization_usage">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_org_usage_org"
                             foreignKeyName="fk_usage_org"
                             references="organizations(id)"/>
            </column>
            <column name="document_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="storage_bytes" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="questions_this_month" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reset_date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
